# Copy to the server's env file (on EC2: ~/hr.env, passed with `docker run --env-file ~/hr.env`).

# Behind Caddy/Nginx: trust one proxy hop so HTTPS and client IPs are detected correctly.
TRUST_PROXY=1

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console,
# add the site URL (e.g. https://34-229-222-193.sslip.io) under "Authorized JavaScript origins",
# and paste the Client ID here. Leave empty to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=

# AI resume parsing with OpenAI. Leave OPENAI_API_KEY empty to use the built-in rule-based parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared demo account shown on the sign-in page. Set DEMO_PASSWORD= (empty) to disable it.
DEMO_EMAIL=demo@t3hr.app
DEMO_PASSWORD=demo1234
