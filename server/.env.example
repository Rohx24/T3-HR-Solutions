# Copy to the server's env file (on EC2: ~/hr.env, passed with `docker run --env-file ~/hr.env`).

# Behind Caddy/Nginx: trust one proxy hop so HTTPS and client IPs are detected correctly.
TRUST_PROXY=1

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console,
# add the site URL (e.g. https://34-229-222-193.sslip.io) under "Authorized JavaScript origins",
# and paste the Client ID here. Leave empty to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=

# AI resume parsing with OpenAI. Leave OPENAI_API_KEY empty to use the built-in rule-based parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared demo account shown on the sign-in page. Set DEMO_PASSWORD= (empty) to disable it.
DEMO_EMAIL=demo@t3hr.app
DEMO_PASSWORD=demo1234

# WhatsApp call permission on the public apply page (optional; the apply page works without it).
# When an applicant ticks "contact me on WhatsApp", the server sends this approved template, which must include
# a call permission request button. Template body: {{1}} = first name, {{2}} = job title.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CALL_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Public business number for "Say hi on WhatsApp" links on the thank-you screen, digits only, e.g. 919812345678.
WHATSAPP_DISPLAY_NUMBER=

# Call-recording consent and retention (shown to candidates on the consent and privacy pages).
# Contact for questions and deletion requests; defaults to T3Cogno's public address.
PRIVACY_CONTACT_EMAIL=info@t3cogno.com
# Recordings are deleted once notes are taken; anything never transcribed is deleted after this many days.
RECORDING_RETENTION_DAYS=7
